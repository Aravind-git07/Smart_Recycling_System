# AI-Based Smart Recycling System Configuration
# Leave GEMINI_API_KEY blank to use the built-in offline computer-vision heuristic fallback classifier,
# or provide your Google Gemini API key for live generative vision classification.
GEMINI_API_KEY=

# Database URL (defaults to SQLite database recycling_system.db in backend folder)
DATABASE_URL=sqlite:///./recycling_system.db

# Max upload image size in megabytes
MAX_IMAGE_SIZE_MB=10
